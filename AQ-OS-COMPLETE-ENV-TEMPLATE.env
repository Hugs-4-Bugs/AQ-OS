# ============================================================
# AcquisitionOS — COMPLETE ENVIRONMENT TEMPLATE
# ============================================================
# Generated from codebase audit at commit 09420b826 (origin/develop)
# 238 unique environment variables discovered via process.env.* scan.
#
# Legend:
#   <EXISTING_CONFIGURED_VALUE>     = already set in current GLM .env
#   <EXISTING_CONFIGURED_SECRET>    = already set in current GLM .env (secret)
#   <SET_IN_VERCEL>                 = must be configured in Vercel env vars
#   <optional>                      = not required for basic operation
#   <dev_only>                      = only used in development
#   <test_only>                     = only used in test suite
#   <auto>                          = set automatically by platform (Vercel/Node)
#
# DO NOT commit real secret values to Git. .env is gitignored.
# ============================================================

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=<EXISTING_CONFIGURED_VALUE>
SQLITE_URL=<optional_legacy_alias_for_DATABASE_URL>
PG_URL=<optional_alias_for_postgres_DATABASE_URL>
TEST_DATABASE_URL=<test_only_isolated_test_DB>
DATABASE_CONNECT_TIMEOUT_S=<optional_default_15>
DATABASE_IDLE_TIMEOUT_MS=<optional_default_10000>
DATABASE_POOL_SIZE=<optional_default_5>
DATABASE_QUERY_TIMEOUT_MS=<optional_default_30000>
DATABASE_STATEMENT_TIMEOUT_S=<optional_default_0>
DATABASE_TIMEOUT_MS=<optional_default_30000>
DATABASE_SSL_MODE=<optional_disable_require_allow>
PGBOUNCER_ENABLED=<optional_for_postgres_pgbouncer>
ALLOW_DB_RESET=<optional_safety_guard_false>

# ============================================================
# AUTH / SESSION / JWT
# ============================================================
JWT_SECRET=<EXISTING_CONFIGURED_SECRET>
