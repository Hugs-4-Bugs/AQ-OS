AUTH_AUTO_VERIFY=<EXISTING_CONFIGURED_VALUE_false_for_production>
AUTH_BYPASS_EMAIL=<EXISTING_CONFIGURED_VALUE_false_for_production>
AUTH_DEV_OTP_IN_LOG=<EXISTING_CONFIGURED_VALUE_false_for_production>
AUTH_DEV_OTP_IN_RESPONSE=<EXISTING_CONFIGURED_VALUE_false_for_production>
VERIFY_USER_EMAIL=<test_only>
VERIFY_USER_PASSWORD=<test_only>
VERIFY_USER_PLAN=<test_only>
RELAY_SECRET=<optional_oauth_relay_token_signing>
SECRET_KEY=<optional_legacy_alias>
ENCRYPTION_KEY=<optional_AES_master_key_for_sensitive_data>
USER_AI_PROVIDER_ENCRYPTION_KEY=<optional_64char_hex_for_user_AI_provider_credentials>

# Auth feature flags
ENABLE_GOOGLE_OAUTH=<EXISTING_CONFIGURED_VALUE_true>
ENABLE_MAGIC_LINK=<EXISTING_CONFIGURED_VALUE_true>
