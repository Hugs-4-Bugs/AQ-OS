# ══════════════════════════════════════════════════════════════════
# AcquisitionOS — Frontend Dockerfile (Development)
# Uses Bun for ARM64 support - runs Next.js directly without boot-recovery
# ══════════════════════════════════════════════════════════════════

FROM oven/bun:1.1-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache libc6-compat

# Copy package files, lockfile for dependency installation
COPY package.json bun.lock .npmrc ./

# Install dependencies with bun (handles platform-specific packages correctly)
RUN bun install

# Copy prisma schema and generate client
COPY prisma ./prisma/
RUN bunx prisma generate

# Copy source code
COPY . .

# Create non-root user for development
RUN addgroup --system --gid 1001 devjs && \
    adduser --system --uid 1001 devuser
RUN mkdir -p /app/data && chown devuser:devjs /app/data

USER devuser

EXPOSE 3000

# Development server with hot reload - run Next.js directly via bunx
# Skip boot-recovery.mjs which has node:sqlite import that doesn't work in bun
CMD ["bunx", "next", "dev", "-p", "3000"]
