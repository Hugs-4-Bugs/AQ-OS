{
  "annotations": { "list": [] },
  "description": "AcquisitionOS — API endpoint availability, errors, and latency. Privacy-safe: only route templates, no user IDs.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "table", "title": "Endpoint status code distribution (last 5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 }, "id": 1,
      "targets": [{ "expr": "sum by (route, status) (rate(api_requests_total[5m])) * 60", "format": "table", "instant": true, "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "p95 Latency by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }, "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (route, le) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries", "title": "5xx Error Rate by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }, "id": 3,
      "targets": [{ "expr": "sum by (route) (rate(api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (route) (rate(api_requests_total[5m])), 1) * 100", "legendFormat": "{{route}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["acquisitionos", "api"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "AcquisitionOS — API Endpoints",
  "uid": "acos-api-endpoints",
  "version": 1
}
