{
  "annotations": { "list": [] },
  "description": "AcquisitionOS — Infrastructure: CPU, memory, disk, network, host availability (node-exporter).",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries", "title": "CPU Usage (%) by host",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "id": 1,
      "targets": [{ "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) by (instance)) * 100", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "timeseries", "title": "Memory Available (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "id": 2,
      "targets": [{ "expr": "(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "timeseries", "title": "Disk Usage (%) by mountpoint",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "id": 3,
      "targets": [{ "expr": "(1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})) * 100", "legendFormat": "{{instance}} {{mountpoint}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "timeseries", "title": "Network Throughput (bytes/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "id": 4,
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total[5m])", "legendFormat": "rx {{instance}}", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total[5m])", "legendFormat": "tx {{instance}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["acquisitionos", "infrastructure"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "AcquisitionOS — Infrastructure",
  "uid": "acos-infrastructure",
  "version": 1
}
