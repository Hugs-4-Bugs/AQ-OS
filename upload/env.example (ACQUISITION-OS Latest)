# ═══════════════════════════════════════════════════════════════════
# AcquisitionOS — Environment Variable Template (COMPLETE INVENTORY)
# Copy to .env:  cp .env.example .env   then fill in real values.
#
# SECURITY RULES:
#   - NEVER put real API keys, passwords or tokens in this file.
#   - NEVER commit .env, .env.local or .env.*.local to Git (.gitignore covers them).
#   - Where to obtain each value is documented in ENVIRONMENT-VARIABLES.md.
#
# Verified against the current codebase (repo-wide process.env /
# os.getenv audit, 2026-09-22 — see ENVIRONMENT-VARIABLES.md).
# Placeholders ONLY — no real values ever belong here.
# ═══════════════════════════════════════════════════════════════════

# ── 1. CORE (required for boot) ─────────────────────────────────────
# SQLite local file — no external database service needed for local dev.
# Production: a managed PostgreSQL URL instead.
DATABASE_URL=file:./db/custom.db
# JWT signing secret — fallback chain in code: JWT_SECRET → AUTH_SECRET → NEXTAUTH_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex
AUTH_SECRET=replace_with_64_char_random_hex
NEXTAUTH_SECRET=replace_with_64_char_random_hex
# Public URL of THIS environment (dynamic request origin is used first; this is the fallback).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Legacy/secondary URL vars used in fallback chains (auth callbacks, Stripe, Gmail OAuth):
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Highest-priority explicit URL override (optional; wins over all other URL sources):
# APP_PUBLIC_URL=https://your-domain.example.com

# ── 2. GOOGLE OAUTH SIGN-IN (required for real Google login) ───────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Whitelist these redirect URIs on the client:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=replace_with_your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_your_client_secret

# ── 3. EMAIL (required for real OTP / magic-link / notification mail) ──
# Provider chain: Resend (primary) → Gmail SMTP (fallback) → dev-mode OTP (dev only).
# Option A — Gmail SMTP (requires a 16-char App Password, NOT your Gmail login password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=replace_with_16_char_gmail_app_password
EMAIL_FROM=your_email@gmail.com
# Accepted alias names (any one of each group is enough — read via email-ethereal.ts):
#   user    : SMTP_USERNAME, GMAIL_USER, EMAIL_USER, MAIL_USER
#   password: SMTP_PASS, SMTP_AUTH_PASSWORD, GMAIL_APP_PASSWORD, GMAIL_PASSWORD, EMAIL_PASSWORD, MAIL_PASSWORD
#   host    : MAIL_HOST, EMAIL_HOST          port: MAIL_PORT, EMAIL_PORT
#   from    : SMTP_FROM, FROM_EMAIL, MAIL_FROM_ADDRESS
# Option B — Resend (takes priority when set): https://resend.com → API Keys
# RESEND_API_KEY=re_replace_with_your_resend_api_key

# ── 4. AUTH BEHAVIOUR FLAGS ─────────────────────────────────────────
# AUTH_DEV_MODE: when "false" (or when real email IS configured), the dev
# fallback that prints OTP codes in API responses is disabled.
# Leave unset for local dev convenience; ALWAYS ensure it is "false" in any
# shared/staging environment. Production builds ignore it entirely.
AUTH_DEV_MODE=false
# Read by the PYTHON BACKEND only (backend/app/config.py) — no effect on the Next.js app:
ENABLE_GOOGLE_OAUTH=true
ENABLE_OTP_LOGIN=true
ENABLE_MAGIC_LINK=true
# Read by NOTHING (dead config — kept for parity with old setups):
AUTH_BYPASS_EMAIL=false
AUTH_AUTO_VERIFY=false

# ── 5. GOOGLE CUSTOM SEARCH + DISCOVERY SOURCES (lead discovery) ────
# https://programmablesearchengine.google.com → engine id (cx) + API key.
GOOGLE_SEARCH_API_KEY=replace_with_your_google_api_key
GOOGLE_SEARCH_CX=replace_with_your_search_engine_id
# Optional alternative/extra discovery source adapters (all optional):
# SERPAPI_KEY=replace_with_your_serpapi_key
# GOOGLE_MAPS_API_KEY=replace_me
# YELP_API_KEY=replace_me
# JUSTDIAL_API_KEY=replace_me
# JUSTDIAL_API_URL=replace_me
# INDIAMART_API_KEY=replace_me
# Social OAuth adapters (optional):
# FACEBOOK_APP_ID=replace_me
# FACEBOOK_APP_SECRET=replace_me
# INSTAGRAM_APP_ID=replace_me
# INSTAGRAM_APP_SECRET=replace_me
# LINKEDIN_CLIENT_ID=replace_me
# LINKEDIN_CLIENT_SECRET=replace_me

# ── 6. CRON / BACKGROUND JOBS ───────────────────────────────────────
# Bearer token required by all /api/cron/* endpoints (generate a random string).
# ⚠️ Use a long random value in any shared environment — never a guessable dev string.
CRON_SECRET=replace_with_random_cron_secret
# Alternate token for /api/meetings/reminders/process:
# CRON_AUTH_TOKEN=replace_if_using_meeting_reminders_cron
# GMAIL_CRON_API_KEY=replace_if_using_gmail_reply_cron        # /api/gmail/jobs/process
# GMAIL_TRACKING_BASE_URL=https://your-domain                 # Gmail open/click tracking base
# GMAIL_UNSUBSCRIBE_SECRET=replace_with_random_secret         # HMAC for one-click unsubscribe links

# ── 7. ENCRYPTION KEYS (token encryption at rest) ───────────────────
# ENCRYPTION_KEY: required in PRODUCTION (throws without it). Encrypts OAuth tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=replace_with_64_char_random_hex
# GMAIL_ENCRYPTION_KEY: encrypts Telegram/WhatsApp/legacy Gmail credentials.
# GMAIL_ENCRYPTION_KEY=replace_with_64_char_random_hex
# TOKEN_ENCRYPTION_KEY: PYTHON BACKEND token encryption (backend/app/config.py).
# TOKEN_ENCRYPTION_KEY=replace_with_64_char_random_hex

