// ═══════════════════════════════════════════════════════════════════
// AcquisitionOS — Competitor Intelligence Service
// Phase 13: Competitor Intelligence + Scanning + Analysis + Tracking
//
// REAL data sources only — uses z-ai-web-dev-sdk for web scraping,
// LLM analysis, and discovery. NO fake competitor data.
//
// CRITICAL RULES:
// - NEVER use z-ai-web-dev-sdk on the client side
// - ALWAYS validate userId for org isolation
// - ALWAYS use proper error handling
// - Include in-memory caching with 5-minute TTL
// ═══════════════════════════════════════════════════════════════════

import { db } from '@/lib/db';
import { deductCredits, CREDIT_COSTS, refundCredits } from '@/lib/credit-service';
import ZAI from 'z-ai-web-dev-sdk';

// ═══════════════════════════════════════════════════════════════════
// TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════════

export interface SEOData {
  title: string;
  description: string;
  keywords: string[];
  ogTags: Record<string, string>;
  headingStructure: string[];
  canonicalUrl: string;
  robotsTxt: string;
  sitemapUrl: string;
  score: number; // 0-100
}

export interface PricingData {
  hasPricingPage: boolean;
  pricingUrl: string;
  pricingModel: string; // freemium, subscription, one-time, usage-based, etc.
  tiers: { name: string; price: string; features: string[] }[];
  currency: string;
  lastUpdated: string;
}

export interface SocialData {
  twitter?: { handle: string; followers: number; url: string };
  linkedin?: { handle: string; followers: number; url: string };
  facebook?: { handle: string; likes: number; url: string };
  instagram?: { handle: string; followers: number; url: string };
  youtube?: { handle: string; subscribers: number; url: string };
  overallScore: number;
}

export interface ReviewsData {
  sources: { platform: string; avgRating: number; reviewCount: number; url: string }[];
  overallRating: number;
  totalReviews: number;
  sentiment: 'positive' | 'neutral' | 'negative';
  commonComplaints: string[];
  commonPraises: string[];
}

export interface TechStackData {
  technologies: { name: string; category: string; version?: string }[];
  categories: Record<string, string[]>;
  complexity: 'simple' | 'moderate' | 'complex';
  detectedAt: string;
}

export interface PageSpeedData {
  performanceScore: number;
  accessibility: number;
  bestPractices: number;
  seo: number;
  largestContentfulPaint: number;
  firstInputDelay: number;
  cumulativeLayoutShift: number;
}

export interface ComparisonData {
  competitors: { id: string; name: string; url: string }[];
  metrics: Record<string, (number | string | null)[]>;
  strengths: string[][];
  weaknesses: string[][];
  pricingComparison: { tier: string; prices: (string | null)[] }[];
}

export interface AIInsightsData {
  strategicPosition: string;
  competitiveAdvantages: string[];
  vulnerabilities: string[];
  recommendedActions: { action: string; priority: 'high' | 'medium' | 'low'; reasoning: string }[];
  marketOpportunities: string[];
  threatAssessment: { threat: string; severity: 'low' | 'medium' | 'high'; mitigation: string }[];
}

export interface OpportunityData {
  id: string;
  type: 'pricing' | 'feature' | 'market' | 'seo' | 'social' | 'tech';
  description: string;
  impact: 'low' | 'medium' | 'high';
  effort: 'low' | 'medium' | 'high';
  score: number; // 0-100
}

export interface ChangeData {
  field: string;
  previousValue: unknown;
  newValue: unknown;
  detectedAt: string;
  significance: 'low' | 'medium' | 'high';
}

export interface TrendData {
  date: string;
  value: number;
}

// ═══════════════════════════════════════════════════════════════════
// IN-MEMORY CACHE (5-minute TTL)
// ═══════════════════════════════════════════════════════════════════

interface CacheEntry<T> {
  data: T;
  expiresAt: number;
}

const CACHE_TTL_MS = 5 * 60 * 1000; // 5 minutes
const competitorCache = new Map<string, CacheEntry<unknown>>();

function cacheGet<T>(key: string): T | null {
  const entry = competitorCache.get(key);
  if (!entry) return null;
  if (Date.now() > entry.expiresAt) {
    competitorCache.delete(key);
    return null;
  }
  return entry.data as T;
}

function cacheSet<T>(key: string, data: T, ttlMs = CACHE_TTL_MS): void {
  competitorCache.set(key, { data, expiresAt: Date.now() + ttlMs });
}

function cacheInvalidate(prefix: string): void {
  for (const key of competitorCache.keys()) {
    if (key.startsWith(prefix)) {
      competitorCache.delete(key);
    }
  }
}

// ═══════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════

const DEFAULT_PAGE_LIMIT = 20;
const MAX_PAGE_LIMIT = 100;
const COMPETITOR_CREDIT_COST = CREDIT_COSTS.competitor_analysis; // 8 credits

// ═══════════════════════════════════════════════════════════════════
// HELPER: INITIALIZE ZAI SDK
// ═══════════════════════════════════════════════════════════════════

async function initZAI(): Promise<InstanceType<typeof ZAI>> {
  try {
    return await ZAI.create();
  } catch {
    throw new Error('Failed to initialize AI SDK. Check API configuration.');
  }
}

// ═══════════════════════════════════════════════════════════════════
// HELPER: ORG ISOLATION VALIDATION
// ═══════════════════════════════════════════════════════════════════

async function validateUserOwnsCompetitor(userId: string, competitorId: string): Promise<boolean> {
  const competitor = await db.competitorAnalysis.findFirst({
    where: { id: competitorId, userId },
    select: { id: true },
  });
  return !!competitor;
}

// ═══════════════════════════════════════════════════════════════════
// HELPER: PARSE LLM JSON RESPONSE
// ═══════════════════════════════════════════════════════════════════

function parseLLMJson<T>(content: string, fallback: T): T {
  try {
    let cleaned = content.trim();
    if (cleaned.startsWith('```')) {
      cleaned = cleaned.replace(/^```(?:json)?\n?/, '').replace(/\n?```$/, '');
    }
    const parsed = JSON.parse(cleaned);
    return parsed as T;
  } catch {
    return fallback;
  }
}

// ═══════════════════════════════════════════════════════════════════
// HELPER: URL NORMALIZATION
// ═══════════════════════════════════════════════════════════════════

function normalizeUrl(url: string): string {
  let normalized = url.trim();
  if (!normalized.startsWith('http://') && !normalized.startsWith('https://')) {
    normalized = 'https://' + normalized;
  }
  // Remove trailing slash
  return normalized.replace(/\/+$/, '');
}

// ═══════════════════════════════════════════════════════════════════
// 1. COMPETITOR CRUD
// ═══════════════════════════════════════════════════════════════════

/**
 * Create a new competitor record with both CompetitorData (raw) and CompetitorAnalysis (processed).
 */
export async function createCompetitor(
  userId: string,
  data: { name: string; url: string; leadId?: string }
): Promise<unknown> {
  const normalizedUrl = normalizeUrl(data.url);

  // Check for duplicate URL for this user
  const existing = await db.competitorAnalysis.findFirst({
    where: { userId, competitorUrl: normalizedUrl },
  });

  if (existing) {
    throw new Error(`Competitor with URL "${normalizedUrl}" already exists for this user.`);
  }

  // Create CompetitorData (raw storage)
  const competitorData = await db.competitorData.create({
    data: {
      competitorName: data.name,
      competitorUrl: normalizedUrl,
    },
  });

  // Create CompetitorAnalysis (processed/analyzed storage)
  const analysis = await db.competitorAnalysis.create({
    data: {
      userId,
      leadId: data.leadId || null,
      competitorName: data.name,
      competitorUrl: normalizedUrl,
      competitorDataId: competitorData.id,
      threatLevel: 'medium', // default until analyzed
    },
  });

  // Invalidate cache
  cacheInvalidate(`competitors:${userId}`);

  return analysis;
}

/**
 * List competitors with pagination and optional threat level filter.
 */
export async function getCompetitors(
  userId: string,
  filters?: { threatLevel?: string; page?: number; limit?: number }
): Promise<{ data: unknown[]; total: number }> {
  const page = Math.max(1, filters?.page || 1);
  const limit = Math.min(MAX_PAGE_LIMIT, Math.max(1, filters?.limit || DEFAULT_PAGE_LIMIT));
  const offset = (page - 1) * limit;

  const cacheKey = `competitors:${userId}:list:${filters?.threatLevel || 'all'}:${page}:${limit}`;
  const cached = cacheGet<{ data: unknown[]; total: number }>(cacheKey);
  if (cached) return cached;

  const where: Record<string, unknown> = { userId };
  if (filters?.threatLevel) {
    where.threatLevel = filters.threatLevel;
  }

  const [data, total] = await Promise.all([
    db.competitorAnalysis.findMany({
      where,
      orderBy: { updatedAt: 'desc' },
      take: limit,
      skip: offset,
    }),
    db.competitorAnalysis.count({ where }),
  ]);

  const result = { data, total };
  cacheSet(cacheKey, result);
  return result;
}

/**
 * Get a single competitor profile by ID.
 */
export async function getCompetitorById(
  userId: string,
  id: string
): Promise<unknown | null> {
  const cacheKey = `competitors:${userId}:detail:${id}`;
  const cached = cacheGet<unknown>(cacheKey);
  if (cached) return cached;

  const competitor = await db.competitorAnalysis.findFirst({
    where: { id, userId },
  });

  if (!competitor) return null;

  cacheSet(cacheKey, competitor);
  return competitor;
}

/**
 * Update competitor analysis fields.
 */
export async function updateCompetitor(
  userId: string,
  id: string,
  data: Record<string, unknown>
): Promise<unknown> {
  // Validate ownership
  const existing = await db.competitorAnalysis.findFirst({
    where: { id, userId },
  });

  if (!existing) {
    throw new Error('Competitor not found or access denied.');
  }

  // Filter allowed fields
  const allowedFields = [
    'competitorName', 'competitorUrl', 'techStack', 'seoScore', 'socialScore',
    'strengths', 'weaknesses', 'opportunities', 'threats', 'threatLevel',
    'pricingModel', 'estimatedTrafficTier', 'differentiationOpportunities',
    'analysisData', 'socialProfiles', 'pricingDetails', 'reviewsData',
    'lighthouseData', 'pageSpeedData', 'aiComparisonData', 'opportunityScore',
    'lastAnalyzedAt', 'leadId',
  ];

  const updateData: Record<string, unknown> = {};
  for (const field of allowedFields) {
    if (data[field] !== undefined) {
      // Serialize JSON fields
      if (['techStack', 'strengths', 'weaknesses', 'opportunities', 'threats',
           'differentiationOpportunities', 'analysisData', 'socialProfiles',
           'pricingDetails', 'reviewsData', 'lighthouseData', 'pageSpeedData',
           'aiComparisonData'].includes(field)) {
        updateData[field] = typeof data[field] === 'string' ? data[field] : JSON.stringify(data[field]);
      } else {
        updateData[field] = data[field];
      }
    }
  }

  const updated = await db.competitorAnalysis.update({
    where: { id },
    data: updateData,
  });

  // Invalidate cache
  cacheInvalidate(`competitors:${userId}`);

  return updated;
}

/**
 * Delete a competitor with org isolation check.
 */
export async function deleteCompetitor(userId: string, id: string): Promise<void> {
  // Validate ownership
  const existing = await db.competitorAnalysis.findFirst({
    where: { id, userId },
  });

  if (!existing) {
    throw new Error('Competitor not found or access denied.');
  }

  // Delete associated snapshots
  await db.competitorSnapshot.deleteMany({
    where: { competitorId: id },
  });

  // Delete associated competitor data
  if (existing.competitorDataId) {
    await db.competitorData.deleteMany({
      where: { id: existing.competitorDataId },
    }).catch(() => {
      // Best effort — competitor data may already be deleted
    });
  }

  // Delete the analysis record
  await db.competitorAnalysis.delete({
    where: { id },
  });

  // Invalidate cache
  cacheInvalidate(`competitors:${userId}`);
}

// ═══════════════════════════════════════════════════════════════════
// 2. COMPETITOR SCANNING
// ═══════════════════════════════════════════════════════════════════

/**
 * Scan a competitor's website — fetches HTML, extracts SEO metadata,
 * tech stack, social links, and other data.
 */
export async function scanCompetitorWebsite(
  userId: string,
  competitorId: string
): Promise<unknown> {
  const isOwner = await validateUserOwnsCompetitor(userId, competitorId);
  if (!isOwner) throw new Error('Competitor not found or access denied.');

  // Deduct credits
  const creditResult = await deductCredits({
    userId,
    action: 'competitor_analysis',
    cost: COMPETITOR_CREDIT_COST,
    referenceId: competitorId,
  });

  if (!creditResult.success) {
    throw new Error(creditResult.error || 'Insufficient credits for competitor scan.');
  }

  try {
    const competitor = await db.competitorAnalysis.findFirst({
      where: { id: competitorId, userId },
    });

    if (!competitor) throw new Error('Competitor not found.');

    const zai = await initZAI();

    // Step 1: Read the competitor's website
    let websiteHtml = '';
    let pageTitle = '';
    let pageDescription = '';
    let pageContent = '';

    try {
      const pageResult = await zai.functions.invoke('page_reader', {
        url: competitor.competitorUrl,
      });

      if (pageResult?.data?.html) {
        websiteHtml = pageResult.data.html;
        // Truncate for storage
        pageContent = websiteHtml.substring(0, 20000);
      }

      // Try to extract title and description from HTML
      const titleMatch = websiteHtml.match(/<title[^>]*>([^<]+)<\/title>/i);
      if (titleMatch) pageTitle = titleMatch[1].trim();

      const descMatch = websiteHtml.match(/<meta[^>]*name=["']description["'][^>]*content=["']([^"']+)["'][^>]*>/i)
        || websiteHtml.match(/<meta[^>]*content=["']([^"']+)["'][^>]*name=["']description["'][^>]*>/i);
      if (descMatch) pageDescription = descMatch[1].trim();
    } catch (err) {
      console.warn(`[CompetitorIntel] Failed to read website ${competitor.competitorUrl}:`, err);
    }

    // Step 2: Web search for additional info about the competitor
    let searchSnippet = '';
    try {
      const searchResults = await zai.functions.invoke('web_search', {
        query: `${competitor.competitorName} company overview services features`,
        num: 5,
      });

      if (searchResults && searchResults.length > 0) {
        searchSnippet = searchResults
          .map((r: { name: string; snippet: string; url: string }) => `Source: ${r.url}\n${r.snippet}`)
          .join('\n\n');
      }
    } catch {
      // Continue without search results
    }

    // Step 3: Use LLM to extract structured data from the website
    const extractedData = await extractWebsiteData(zai, competitor, pageContent, searchSnippet);

    // Step 4: Update CompetitorData (raw) with scraped data
    if (competitor.competitorDataId) {
      await db.competitorData.update({
        where: { id: competitor.competitorDataId },
        data: {
          websiteHtml: websiteHtml.substring(0, 50000), // Limit raw HTML storage
          lastScrapedAt: new Date(),
          description: extractedData.description || pageDescription || null,
          industry: extractedData.industry || null,
          location: extractedData.location || null,
          socialProfiles: extractedData.socialProfiles ? JSON.stringify(extractedData.socialProfiles) : undefined,
          seoMetadata: JSON.stringify({
            title: pageTitle || extractedData.title,
            description: pageDescription || extractedData.description,
            keywords: extractedData.keywords || [],
          }),
          techStackData: extractedData.techStack ? JSON.stringify(extractedData.techStack) : undefined,
        },
      });
    }

    // Step 5: Update CompetitorAnalysis (processed) with extracted insights
    const updatedAnalysis = await db.competitorAnalysis.update({
      where: { id: competitorId },
      data: {
        techStack: extractedData.techStack ? JSON.stringify(extractedData.techStack) : competitor.techStack,
        seoScore: extractedData.seoScore ?? competitor.seoScore,
        socialScore: extractedData.socialScore ?? competitor.socialScore,
        strengths: extractedData.strengths ? JSON.stringify(extractedData.strengths) : competitor.strengths,
        weaknesses: extractedData.weaknesses ? JSON.stringify(extractedData.weaknesses) : competitor.weaknesses,
        socialProfiles: extractedData.socialProfiles ? JSON.stringify(extractedData.socialProfiles) : competitor.socialProfiles,
        lastAnalyzedAt: new Date(),
        analysisData: JSON.stringify(extractedData),
      },
    });

    // Invalidate cache
    cacheInvalidate(`competitors:${userId}`);

    return updatedAnalysis;
  } catch (error) {
    // Refund credits on failure
    await refundCredits({
      userId,
      amount: COMPETITOR_CREDIT_COST,
      originalAction: 'competitor_analysis',
      referenceId: competitorId,
    }).catch(() => {});

    const message = error instanceof Error ? error.message : 'Unknown error during competitor scan';
    throw new Error(message);
  }
}

/**
 * Internal: Extract structured website data using LLM.
 */
async function extractWebsiteData(
  zai: InstanceType<typeof ZAI>,
  competitor: { competitorName: string; competitorUrl: string },
  pageContent: string,
  searchSnippet: string
): Promise<Record<string, unknown>> {
  const truncatedContent = pageContent.substring(0, 8000);

  const prompt = `You are a competitor analysis assistant. Analyze the following website content and search results for the competitor "${competitor.competitorName}" (${competitor.competitorUrl}).

WEBSITE CONTENT (truncated):
${truncatedContent || 'No website content available'}

SEARCH RESULTS:
${searchSnippet || 'No search results available'}

Extract the following as a JSON object:
{
  "title": "Page title",
  "description": "Meta description or site description",
  "industry": "Industry/category",
  "location": "Primary location if found",
  "keywords": ["keyword1", "keyword2", ...],
  "socialProfiles": {
    "twitter": "URL or null",
    "linkedin": "URL or null",
    "facebook": "URL or null",
    "instagram": "URL or null",
    "youtube": "URL or null"
  },
  "techStack": ["Technology1", "Technology2", ...],
  "seoScore": 0-100,
  "socialScore": 0-100,
  "strengths": ["strength1", "strength2", ...],
  "weaknesses": ["weakness1", "weakness2", ...],
  "pricingIndicators": "Any pricing hints found on the page",
  "targetAudience": "Who they seem to target",
  "uniqueSellingPoints": ["USP1", "USP2", ...],
  "contentQuality": "poor/basic/good/excellent",
  "mobileFriendly": true/false,
  "hasBlog": true/false,
  "hasPricingPage": true/false,
  "hasTestimonials": true/false
}

Return ONLY the JSON object. No markdown, no explanations.`;

  try {
    const response = await zai.chat.completions.create({
      messages: [
        { role: 'system', content: 'You are a precise competitor analysis assistant. Return only valid JSON. No markdown, no explanations.' },
        { role: 'user', content: prompt },
      ],
      model: 'auto',
    });

    const content = response.choices?.[0]?.message?.content || '{}';
    return parseLLMJson(content, {});
  } catch (error) {
    console.error('[CompetitorIntel] LLM website extraction failed:', error);
    return {};
  }
}

/**
 * Scan competitor SEO metadata from their website.
 */
export async function scanCompetitorSEO(
  userId: string,
  competitorId: string
): Promise<SEOData> {
  const isOwner = await validateUserOwnsCompetitor(userId, competitorId);
  if (!isOwner) throw new Error('Competitor not found or access denied.');

  const cacheKey = `competitors:${userId}:seo:${competitorId}`;
  const cached = cacheGet<SEOData>(cacheKey);
  if (cached) return cached;

  const competitor = await db.competitorAnalysis.findFirst({
    where: { id: competitorId, userId },
  });

  if (!competitor) throw new Error('Competitor not found.');

  const zai = await initZAI();

  // Read the website
  let websiteHtml = '';
  try {
    const pageResult = await zai.functions.invoke('page_reader', {
      url: competitor.competitorUrl,
    });
    if (pageResult?.data?.html) {
      websiteHtml = pageResult.data.html;
    }
  } catch {
    // Continue without HTML
  }

  // Extract SEO data from HTML
  const seoData = extractSEOFromHtml(websiteHtml);

  // Use LLM for deeper SEO analysis if we have content
  if (websiteHtml.length > 500) {
    const llmSeo = await extractSEOWithLLM(zai, competitor, websiteHtml);
    // Merge LLM findings with HTML-parsed data
    if (llmSeo.keywords.length > 0) seoData.keywords = llmSeo.keywords;
    if (llmSeo.headingStructure.length > 0) seoData.headingStructure = llmSeo.headingStructure;
    if (llmSeo.score > 0) seoData.score = llmSeo.score;
  }

  // Update analysis with SEO data
  await db.competitorAnalysis.update({
    where: { id: competitorId },
    data: {
      seoScore: seoData.score,
    },
  });

  cacheSet(cacheKey, seoData);
  cacheInvalidate(`competitors:${userId}:detail:${competitorId}`);

  return seoData;
}

/**
 * Internal: Extract basic SEO data from raw HTML.
 */
function extractSEOFromHtml(html: string): SEOData {
  const result: SEOData = {
    title: '',
    description: '',
    keywords: [],
    ogTags: {},
    headingStructure: [],
    canonicalUrl: '',
    robotsTxt: '',
    sitemapUrl: '',
    score: 0,
  };

  if (!html) return result;

  // Title
  const titleMatch = html.match(/<title[^>]*>([^<]+)<\/title>/i);
  if (titleMatch) result.title = titleMatch[1].trim();

  // Meta description
  const descMatch = html.match(/<meta[^>]*name=["']description["'][^>]*content=["']([^"']+)["'][^>]*>/i)
    || html.match(/<meta[^>]*content=["']([^"']+)["'][^>]*name=["']description["'][^>]*>/i);
  if (descMatch) result.description = descMatch[1].trim();

  // Meta keywords
  const kwMatch = html.match(/<meta[^>]*name=["']keywords["'][^>]*content=["']([^"']+)["'][^>]*>/i)
    || html.match(/<meta[^>]*content=["']([^"']+)["'][^>]*name=["']keywords["'][^>]*>/i);
  if (kwMatch) result.keywords = kwMatch[1].split(',').map(k => k.trim()).filter(Boolean);

  // OG tags
  const ogMatches = html.matchAll(/<meta[^>]*property=["']og:([^"']+)["'][^>]*content=["']([^"']+)["'][^>]*>/gi);
  for (const match of ogMatches) {
    result.ogTags[`og:${match[1]}`] = match[2];
  }

  // Canonical URL
  const canonicalMatch = html.match(/<link[^>]*rel=["']canonical["'][^>]*href=["']([^"']+)["'][^>]*>/i);
  if (canonicalMatch) result.canonicalUrl = canonicalMatch[1];

  // Heading structure
  const headingMatches = html.matchAll(/<h([1-6])[^>]*>([^<]+)<\/h[1-6]>/gi);
  for (const match of headingMatches) {
    result.headingStructure.push(`H${match[1]}: ${match[2].trim()}`);
  }

  // Calculate basic SEO score (0-100)
  let score = 0;
  if (result.title) score += 15;
  if (result.title && result.title.length <= 60) score += 10;
  if (result.description) score += 15;
  if (result.description && result.description.length <= 160) score += 10;
  if (result.keywords.length > 0) score += 10;
  if (result.ogTags['og:title']) score += 10;
  if (result.ogTags['og:description']) score += 5;
  if (result.ogTags['og:image']) score += 5;
  if (result.canonicalUrl) score += 10;
  if (result.headingStructure.length > 0) score += 10;
  result.score = Math.min(100, score);

  return result;
}

/**
 * Internal: Use LLM for deeper SEO analysis.
 */
async function extractSEOWithLLM(
  zai: InstanceType<typeof ZAI>,
  competitor: { competitorName: string; competitorUrl: string },
  html: string
): Promise<{ keywords: string[]; headingStructure: string[]; score: number }> {
  const prompt = `Analyze the SEO of this website for "${competitor.competitorName}" (${competitor.competitorUrl}).

HTML (truncated):
${html.substring(0, 6000)}

Return a JSON object:
{
  "keywords": ["primary keyword", "secondary keyword", ...],
  "headingStructure": ["H1: main heading", "H2: sub heading", ...],
  "score": 0-100 (overall SEO score based on title, meta, headings, content quality, structure)
}

Return ONLY JSON. No markdown.`;

  try {
    const response = await zai.chat.completions.create({
      messages: [
        { role: 'system', content: 'You are an SEO analysis assistant. Return only valid JSON.' },
        { role: 'user', content: prompt },
      ],
      model: 'auto',
    });

    const content = response.choices?.[0]?.message?.content || '{}';
    return parseLLMJson(content, { keywords: [], headingStructure: [], score: 0 });
  } catch {
    return { keywords: [], headingStructure: [], score: 0 };
  }
}

/**
 * Scan competitor pricing info by searching for their pricing page.
 */
export async function scanCompetitorPricing(
  userId: string,
  competitorId: string
): Promise<PricingData> {
  const isOwner = await validateUserOwnsCompetitor(userId, competitorId);
  if (!isOwner) throw new Error('Competitor not found or access denied.');

  const cacheKey = `competitors:${userId}:pricing:${competitorId}`;
  const cached = cacheGet<PricingData>(cacheKey);
  if (cached) return cached;

  const competitor = await db.competitorAnalysis.findFirst({
    where: { id: competitorId, userId },
  });

  if (!competitor) throw new Error('Competitor not found.');

  const zai = await initZAI();

  // Search for competitor pricing page
  let pricingPageUrl = '';
  let pricingSearchContent = '';

  try {
    const searchResults = await zai.functions.invoke('web_search', {
      query: `${competitor.competitorName} pricing plans cost`,
      num: 5,
    });

    if (searchResults && searchResults.length > 0) {
      for (const result of searchResults as Array<{ url: string; name: string; snippet: string }>) {
        if (result.url.toLowerCase().includes('pricing') || result.name.toLowerCase().includes('pricing')) {
          pricingPageUrl = result.url;
          break;
        }
      }

      pricingSearchContent = (searchResults as Array<{ url: string; snippet: string }>)
        .map(r => `${r.url}: ${r.snippet}`)
        .join('\n');
    }
  } catch {
    // Continue without search
  }

  // Try to read the pricing page
  let pricingPageContent = '';
  if (pricingPageUrl) {
    try {
      const pageResult = await zai.functions.invoke('page_reader', {
        url: pricingPageUrl,
      });
      if (pageResult?.data?.html) {
        pricingPageContent = pageResult.data.html.substring(0, 10000);
      }
    } catch {
      // Continue without pricing page content
    }
  }

  // Use LLM to extract pricing data
  const pricingData = await extractPricingWithLLM(zai, competitor, pricingSearchContent, pricingPageContent, pricingPageUrl);

  // Update competitor analysis
  await db.competitorAnalysis.update({
    where: { id: competitorId },
    data: {
      pricingModel: pricingData.pricingModel || competitor.pricingModel,
      pricingDetails: JSON.stringify(pricingData),
    },
  });

  cacheSet(cacheKey, pricingData);
  cacheInvalidate(`competitors:${userId}:detail:${competitorId}`);

  return pricingData;
}

/**
 * Internal: Extract pricing data using LLM.
 */
async function extractPricingWithLLM(
  zai: InstanceType<typeof ZAI>,
  competitor: { competitorName: string; competitorUrl: string },
  searchContent: string,
  pageContent: string,
  pricingUrl: string
): Promise<PricingData> {
  const prompt = `Extract pricing information for "${competitor.competitorName}" (${competitor.competitorUrl}).

SEARCH RESULTS:
${searchContent || 'No search results'}

PRICING PAGE CONTENT (truncated):
${pageContent || 'No pricing page content'}

Return a JSON object:
{
  "hasPricingPage": true/false,
  "pricingUrl": "${pricingUrl}",
  "pricingModel": "freemium|subscription|one-time|usage-based|enterprise|custom|unknown",
  "tiers": [
    {"name": "Free/Basic/Pro/etc", "price": "$X/month or Free", "features": ["feature1", "feature2"]}
  ],
  "currency": "USD/EUR/etc",
  "lastUpdated": "${new Date().toISOString().split('T')[0]}"
}

Return ONLY JSON. No markdown.`;

  try {
    const response = await zai.chat.completions.create({
      messages: [
        { role: 'system', content: 'You are a pricing analysis assistant. Return only valid JSON.' },
        { role: 'user', content: prompt },
      ],
      model: 'auto',
    });

    const content = response.choices?.[0]?.message?.content || '{}';
    const result = parseLLMJson<PricingData>(content, {
      hasPricingPage: false,
      pricingUrl: '',
      pricingModel: 'unknown',
      tiers: [],
      currency: 'USD',
      lastUpdated: new Date().toISOString().split('T')[0],
    });

    // Ensure pricingUrl is populated
    if (!result.pricingUrl && pricingUrl) {
      result.pricingUrl = pricingUrl;
    }

    return result;
  } catch {
    return {
      hasPricingPage: !!pricingUrl,
      pricingUrl,
      pricingModel: 'unknown',
      tiers: [],
      currency: 'USD',
      lastUpdated: new Date().toISOString().split('T')[0],
    };
  }
}

/**
 * Scan competitor social profiles by searching the web.
 */
export async function scanCompetitorSocial(
  userId: string,
  competitorId: string
): Promise<SocialData> {
  const isOwner = await validateUserOwnsCompetitor(userId, competitorId);
  if (!isOwner) throw new Error('Competitor not found or access denied.');

  const cacheKey = `competitors:${userId}:social:${competitorId}`;
  const cached = cacheGet<SocialData>(cacheKey);
  if (cached) return cached;

  const competitor = await db.competitorAnalysis.findFirst({
    where: { id: competitorId, userId },
  });

  if (!competitor) throw new Error('Competitor not found.');

  const zai = await initZAI();

  // Search for each social platform
  const socialSearches = [
    { platform: 'twitter', query: `site:twitter.com ${competitor.competitorName}` },
    { platform: 'linkedin', query: `site:linkedin.com/company ${competitor.competitorName}` },
    { platform: 'facebook', query: `site:facebook.com ${competitor.competitorName}` },
    { platform: 'instagram', query: `site:instagram.com ${competitor.competitorName}` },
    { platform: 'youtube', query: `site:youtube.com ${competitor.competitorName} channel` },
  ];

  const socialResults: Record<string, string> = {};

  for (const search of socialSearches) {
    try {
      const results = await zai.functions.invoke('web_search', {
        query: search.query,
        num: 3,
      });

      if (results && results.length > 0) {
        socialResults[search.platform] = (results as Array<{ url: string; snippet: string }>)
          .map(r => `${r.url}: ${r.snippet}`)
          .join('\n');
      }
    } catch {
      // Continue with next platform
    }
  }

  // Use LLM to extract social data
  const socialData = await extractSocialWithLLM(zai, competitor, socialResults);

  // Update competitor analysis
  await db.competitorAnalysis.update({
    where: { id: competitorId },
    data: {
      socialProfiles: JSON.stringify(socialData),
      socialScore: socialData.overallScore,
    },
  });

  cacheSet(cacheKey, socialData);
  cacheInvalidate(`competitors:${userId}:detail:${competitorId}`);

  return socialData;
}

/**
 * Internal: Extract social data using LLM.
 */
async function extractSocialWithLLM(
  zai: InstanceType<typeof ZAI>,
  competitor: { competitorName: string; competitorUrl: string },
  socialResults: Record<string, string>
): Promise<SocialData> {
  const prompt = `Extract social media profile data for "${competitor.competitorName}" (${competitor.competitorUrl}).

SEARCH RESULTS:
${Object.entries(socialResults).map(([platform, content]) => `${platform.toUpperCase()}:\n${content}`).join('\n\n') || 'No social search results found'}

Return a JSON object:
{
  "twitter": {"handle": "@handle", "followers": 0, "url": "https://twitter.com/handle"} or null,
  "linkedin": {"handle": "company-name", "followers": 0, "url": "https://linkedin.com/company/name"} or null,
  "facebook": {"handle": "page-name", "likes": 0, "url": "https://facebook.com/name"} or null,
  "instagram": {"handle": "@handle", "followers": 0, "url": "https://instagram.com/handle"} or null,
  "youtube": {"handle": "channel-name", "subscribers": 0, "url": "https://youtube.com/@name"} or null,
  "overallScore": 0-100 (based on social presence strength)
}

If a platform is not found, use null for that platform.
Return ONLY JSON. No markdown.`;

  try {
    const response = await zai.chat.completions.create({
      messages: [
        { role: 'system', content: 'You are a social media analysis assistant. Return only valid JSON.' },
        { role: 'user', content: prompt },
      ],
      model: 'auto',
    });

    const content = response.choices?.[0]?.message?.content || '{}';
    const result = parseLLMJson<SocialData>(content, { overallScore: 0 });

    // Calculate overall score if not provided
    if (!result.overallScore) {
      let score = 0;
      const platforms = ['twitter', 'linkedin', 'facebook', 'instagram', 'youtube'] as const;
      let platformCount = 0;
      for (const platform of platforms) {
        const data = result[platform] as { followers?: number; likes?: number; subscribers?: number } | undefined;
        if (data) {
          platformCount++;
          const count = data.followers || data.likes || data.subscribers || 0;
          if (count > 10000) score += 20;
          else if (count > 1000) score += 15;
          else if (count > 100) score += 10;
          else score += 5;
        }
      }
      result.overallScore = Math.min(100, score + (platformCount * 5));
    }

    return result;
  } catch {
    return { overallScore: 0 };
  }
}

