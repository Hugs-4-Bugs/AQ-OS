// ═══════════════════════════════════════════════════════════════════
// PROSPECTING PIPELINE (5-Step AI Prospect Intelligence)
// STEP 1 Deep Research → STEP 2 Gap Detection → STEP 3 Offer Match
// → STEP 4 Personalized Pitch → STEP 5 Smart Email
// ═══════════════════════════════════════════════════════════════════

model ProspectPipeline {
  id                String    @id @default(cuid())
  leadId            String
  userId            String
  status            String    @default("idle") // idle | running | completed | failed
  currentStep       Int       @default(0) // 0 = not started; 1..5 = step currently running
  totalSteps        Int       @default(5)
  stepStatus        String    @default("{}") // JSON: { "1": "pending|running|completed|failed|skipped" }
  progress          Int       @default(0) // 0-100
  step1ResearchJson String? // STEP 1: company deep research result (JSON)
  step2GapsJson     String? // STEP 2: detected gaps (JSON)
  step3MatchJson    String? // STEP 3: offer-vs-gap match result (JSON)
  step4PitchJson    String? // STEP 4: personalized pitch (JSON)
  step5EmailJson    String? // STEP 5: smart email draft (JSON)
  overallScore      Float? // 0-100 offer-fit score
  temperature       String? // hot | warm | cold
  outreachMessageId String? // OutreachMessage draft created by STEP 5
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// SUPPORT CENTER — customer support tickets + knowledge base
// (Support Center + Downgrade + Responsive Pricing, Sep 2026)
// Conventions mirror FeedbackReport/FeedbackComment/FeedbackStatusLog:
// cuid ids, unique ticketNumber, String status/priority, status log,
// internal (support-staff-only) messages, additive indexes.
// ═══════════════════════════════════════════════════════════════════

model SupportTicket {
  id             String    @id @default(cuid())
  ticketNumber   String    @unique
  userId         String
  category       String // billing | plans | credits | leads | outreach | ai_features | account | technical | integrations | other
  subcategory    String? // e.g. downgrade_plan | upgrade | payment_failure | ...
  subject        String
  description    String
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | WAITING_FOR_USER | RESOLVED | CLOSED
  priority       String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  currentPlan    String? // plan at submission time (free|starter|pro|elite)
  requestedPlan  String? // downgrade/upgrade target plan, if applicable
  billingCycle   String? // monthly | yearly, if applicable
  assignedTo     String? // support/admin user id
  assignedAt     DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  lastRepliedAt  DateTime? // last staff reply (drives user-facing "updated")
  lastActivityAt DateTime  @default(now()) // any message/status change
  source         String    @default("support_center") // support_center | pricing_modal | kb_article | api
  metadata       String? // JSON: e.g. { searchQuery, articleSlug }

  user      User                     @relation(fields: [userId], references: [id])
  messages  SupportTicketMessage[]
  statusLog SupportTicketStatusLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([userId, status])
  @@index([status, priority])
}

model SupportTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  authorRole String   @default("user") // user | admin
  content    String
  isInternal Boolean  @default(false) // internal support notes — NEVER returned to customers
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@index([authorId])
}

model SupportTicketStatusLog {
  id         String   @id @default(cuid())
  ticketId   String
  fromStatus String
  toStatus   String
  changedBy  String
  note       String?
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model KnowledgeBaseArticle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  category        String // getting_started | leads | outreach | ai_features | credits | plans_billing | account_security | troubleshooting | integrations_api
  subcategory     String?
  summary         String // short description shown in lists/search results
  content         String // full article body (markdown-style paragraphs)
  tags            String? // JSON string array for search + display
  keywords        String? // JSON string array of extra search keywords (not displayed)
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
  published       Boolean  @default(true)
  sortOrder       Int      @default(0) // display ordering inside a category
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  feedback KbArticleFeedback[]

  @@index([category])
  @@index([published])
  @@index([sortOrder])
}

model KbArticleFeedback {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  helpful   Boolean
  createdAt DateTime @default(now())

  article KnowledgeBaseArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
}

// ═══════════════════════════════════════════════════════════════════
// Business Profiles — MULTIPLE per user (distinct from UserSettings and
// from User Personal Context). Plan limits (Pro=3 / Elite=7 ACTIVE
// profiles) are enforced server-side via the entitlement service.
// Additive model — no existing table or row is touched.
// ═══════════════════════════════════════════════════════════════════
model BusinessProfile {
  id                    String   @id @default(cuid())
  userId                String
  name                  String
  industry              String?
  description           String?
  productsServices      String?
  offers                String?
  valueProposition      String?
  targetAudience        String?
  targetIndustries      String?
  targetRoles           String?
  geographicMarket      String?
  painPoints            String?
  businessGoals         String?
  differentiators       String?
  proofPoints           String?
  preferredTone         String?
  preferredLanguage     String?
  cta                   String?
  commercialConstraints String?
  customInstructions    String?
  researchPreferences   String?
  outreachPreferences   String?
  status                String   @default("active") // active | archived
  // Phase 14 (Oct 2026): EXPLICIT default-profile selection. Exactly one of
  // a user's active profiles may carry isDefault=true (the setter unsets the
  // previous default, scoped per user). When none is flagged, deterministic
  // fallback = earliest-created active profile. Additive column; existing
  // rows read as false and every legacy query is unchanged.
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflows WorkflowDefinition[]
  webProperties WebProperty[]

  @@index([userId, status])
}

// ═══════════════════════════════════════════════════════════════════
// WebProperty — a URL the user claims as their own business web
// presence. Scoped to a BusinessProfile (which is scoped to a User).
// Multiple web properties per profile are supported (primary website,
// portfolio, product page, landing page, etc.).
// ═══════════════════════════════════════════════════════════════════
model WebProperty {
  id               String    @id @default(cuid())
  businessProfileId String
  userId           String   // denormalized for fast ownership filtering
  url              String
  label            String?  // "Company Website", "Portfolio", "Product Page"
  propertyType     String   @default("website") // website | portfolio | product | landing_page | personal | other
  status           String   @default("active") // active | archived
  lastResearchedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  businessProfile  BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchSnapshots ResearchSnapshot[]

  @@unique([businessProfileId, url])
  @@index([userId])
  @@index([businessProfileId, status])
}

// ═══════════════════════════════════════════════════════════════════
// ResearchSnapshot — one research execution against one WebProperty.
// Versioned: each new research creates a new snapshot (version + 1).
// The latest successful snapshot is the primary source of business
// intelligence. Failed snapshots are preserved for audit but never
// replace a prior successful result.
//
// Provenance: sourceUrls + researchedAt + researchVersion answer
// "where did this come from and when?" Structured fields use normal
// columns; variable-length data uses bounded JSON.
// ═══════════════════════════════════════════════════════════════════
model ResearchSnapshot {
  id               String    @id @default(cuid())
  webPropertyId    String
  userId           String   // denormalized for fast ownership filtering
  status           String   @default("pending") // pending | running | completed | failed
  researchVersion  Int      @default(1)

  // Structured business intelligence (normal columns for high-value fields)
  companyDescription  String?
  valueProposition    String?
  targetAudience      String?
  challenges          String?  // JSON array of strings
  differentiators     String?
  positioning         String?
  acquisitionAngles   String?  // JSON array of recommended outreach angles

  // Website quality signals (from website-scorer.ts output)
  websiteQualityScore Int?     // 0-100
  seoScore            Int?     // 0-100
  techStack           String?  // JSON array of detected technologies
  websiteGaps         String?  // JSON array of identified gaps

  // SWOT (from competitor-intelligence pattern — applicable to self-analysis)
  swot               String?  // JSON { strengths, weaknesses, opportunities, threats }

  // Pricing and social signals (publicly observable)
  pricingSignals     String?  // JSON
  socialProfiles     String?  // JSON

  // Provenance
  sourceUrls         String?  // JSON array of crawled URLs
  confidence         String?  // high | medium | low
  isObserved         Boolean  @default(true) // true = observed fact, false = AI inference

  // Execution metadata
  startedAt          DateTime?
  completedAt        DateTime?
  creditsUsed        Int      @default(0)
  errorMessage       String?

  createdAt          DateTime @default(now())

  webProperty        WebProperty @relation(fields: [webPropertyId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([webPropertyId, researchVersion])
  @@index([userId, status])
  @@index([webPropertyId, status, completedAt])
}

// Research Job — batch deep-research queue over many leads (DiscoveryJob
// pattern: DB row + detached processing + status polling). Additive model.
model ResearchJob {
  id             String    @id @default(cuid())
  userId         String
  status         String    @default("queued") // queued, running, completed, failed, cancelled
  depth          String    @default("deep") // quick | deep
  leadIds        String    @default("[]") // JSON array of lead ids
  total          Int       @default(0)
  results        String? // JSON: { results: [...], completedCount, failedCount, skippedCount }
  completedCount Int       @default(0)
  failedCount    Int       @default(0)
  skippedCount   Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ═══════════════════════════════════════════════════════════════════
// Autopilot — automated niche-based client acquisition (additive).
// Reuses the existing discovery pipeline and workflow execution engine.
// The AutopilotLead ledger is the concurrency-safe "one lead processed
// at most once per autopilot" guard (DB-level unique index) — the runner
// never relies on check-then-insert alone.
// ═══════════════════════════════════════════════════════════════════

model AutopilotWorkflow {
  id              String    @id @default(cuid())
  userId          String
  orgId           String?
  name            String
  // State machine:
  //   DRAFT | ACTIVE | PAUSED | RUNNING | COMPLETED | FAILED | DISABLED
  //   ── Part 1 durable-autopilot extensions ──
  //   | WAITING (intentional pause for external event/approval/time)
  //   | BLOCKED (permanent failure awaiting human intervention)
  //   | CANCELLED (user-aborted; supersedes legacy DISABLED semantics)
  status          String    @default("DRAFT")
  // JSON array of selected niches (multi-select; discovery niche vocabulary)
  niches          String    @default("[]")
  // JSON { country, city } — same shape as existing discovery geography config
  geography       String    @default("{}")
  // Phase 20 — JSON { [nicheKey]: businessProfileId } mapping each selected
  // niche to the saved Business Profile used for that niche's leads.
  // Additive column: legacy rows read as "{}" (no mapping → existing
  // workflow-profile/default precedence, behavior unchanged).
  profileMappings String    @default("{}")
  // Linked user-configured WorkflowDefinition (must be active at run time)
  workflowId      String
  // hourly | every_6_hours | every_12_hours | daily | weekly
  schedule        String    @default("daily")
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastError       String?
  runCount        Int       @default(0)
  // Honest cumulative counters
  totalDiscovered Int       @default(0)
  totalSaved      Int       @default(0)
  totalProcessed  Int       @default(0)
  totalExecutions Int       @default(0)

  // ── Part 1 — Durable Autonomous Autopilot Foundation ──────────
  // Additive columns for the unified time+event trigger + objective
  // lifecycle. All nullable / defaulted so legacy rows remain valid.
  //
  // IANA timezone name for schedule anchoring (e.g. "Asia/Kolkata").
  // NULL = use server-local timezone (legacy behaviour).
  timezone            String?
  // JSON array of event-trigger specs:
  //   [{ "eventType": "new_lead", "enabled": true },
  //    { "eventType": "new_email", "enabled": true, "filter": {...} },
  //    { "eventType": "follow_up_due", "enabled": true },
  //    { "eventType": "approval_response", "enabled": true },
  //    { "eventType": "external_webhook", "enabled": false, "source": "..."}]
  // An empty array (legacy default "[]") means time-only trigger.
  eventTriggers       String   @default("[]")
  // businessId — optional BusinessProfile scoping for multi-business users.
  // NULL = use the legacy workflow-profile mapping / default profile.
  businessId          String?
  // JSON execution-policy document:
  //   { "autoResume": true,
  //     "maxConcurrentInvocations": 1,
  //     "maxRetries": 3,
  //     "backoffMs": 5000,
  //     "leaseTimeoutMs": 600000,
  //     "requireApprovalFor": ["email.send","outreach.send"] }
  executionPolicy     String   @default("{}")
  // JSON approval-policy document:
  //   { "mode": "auto" | "escalate_high_risk" | "always_require",
  //     "escalationChannel": "in_app" | "telegram" | "none",
  //     "expireAfterMs": 86400000 }
  approvalPolicy      String   @default("{}")
  // JSON permissions-policy document:
  //   { "allowedTools": ["lead.search","email.send"],
  //     "deniedTools": ["telegram.notify"],
  //     "dataScope": { "ownLeadsOnly": true, "ownBusinessOnly": true } }
  permissionsPolicy   String   @default("{}")
  // JSON model-strategy reference:
  //   { "strategy": "single" | "sequential" | "parallel",
  //     "models": [{ "provider": "z-ai", "model": "glm-4.6", "role": "fit_scorer" }],
  //     "concurrency": 3 }
  // NULL = use the user's default model strategy (legacy behaviour).
  modelStrategyConfig String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([nextRunAt])
  @@index([workflowId])
  // Part 1 — accelerate event-trigger lookups by businessId + active.
  @@index([businessId])
  @@index([status, nextRunAt])
}

model AutopilotRun {
  id                String  @id @default(cuid())
  autopilotId       String
  userId            String
  // State machine (extended in Part 1):
  //   QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED  (Phase 18 baseline)
  //   ── Part 1 durable-autopilot extensions ──
  //   | WAITING   — intentionally released worker; persisted waiting condition
  //   | BLOCKED   — permanent failure (invalid config / unsupported provider)
  //   | PAUSED    — awaiting human approval/clarification
  status            String  @default("QUEUED")
  // manual | scheduler  (Phase 18 baseline — the high-level trigger category)
  trigger           String  @default("manual")
  // Part 1 — finer trigger classification for unified pipeline observability:
  //   manual | schedule | event | followup | approval_resume | restart_recovery
  // NULL on legacy rows → interpreted as the value of `trigger`.
  triggerType       String?
  // Part 1 — if triggerType = "event" | "followup" | "approval_resume",
  // references the AgentEvent.id that woke this invocation. NULL otherwise.
  triggerEventId    String?
  // JSON snapshot of { niches, geography, profile, workflow } at run time —
  // Phase 18: the run preserves the profile/context snapshot it started
  // with (later profile edits never rewrite history).
  config            String  @default("{}")
  // Phase 18 idempotency/run key — deterministic identity for duplicate
  // invocation protection. Scheduler: "scheduled:{autopilotId}:{slot}" —
  // a replayed tick converges on the SAME run row. Manual: unique per
  // invocation ("manual:{autopilotId}:{epochMs}"). NULL on legacy rows.
  runKey            String? @unique
  // Part 1 — explicit idempotency key for the unified-trigger entry.
  // Distinct from runKey (which is Phase 18 scheduler-specific) so that
  // event-triggered invocations can have their own dedup identity:
  //   schedule → "schedule:{automationId}:{slotEpochMs}"
  //   event    → "event:{automationId}:{triggerEventId}"
  //   manual   → "manual:{automationId}:{epochMs}" (same as runKey)
  // Enforced UNIQUE so duplicate ticks/events converge on the same row.
  idempotencyKey    String? @unique
  // Part 1 — cross-cutting correlation ID (used for log/event/run linking).
  // Same value propagated to AgentEvent.correlationId + WorkflowExecution.correlationId.
  correlationId     String? @unique
  // Phase 18: the run's ONE parent WorkflowExecution (the whole batch —
  // leads are items under it, never per-lead top-level executions).
  executionId       String?
  discovered        Int     @default(0)
  saved             Int     @default(0)
  skippedDupes      Int     @default(0)
  processed         Int     @default(0)
  executionsCreated Int     @default(0)
  // Phase 18 lead-level outcome aggregates (settled by the run finalizer
  // once the parent execution reaches a terminal state).
  leadsCompleted    Int     @default(0)
  leadsFailed       Int     @default(0)
  error             String?

  // ── Part 1 — Durable execution state ────────────────────────────
  // The current worker that has claimed this invocation.
  // Set by atomic claim; cleared on completion / lease expiry.
  // Format: "{hostname}:{pid}:{randomNonce}".
  leaseOwner        String?
  // When the current lease expires. A tick seeing leaseExpiresAt < now
  // is safe to reclaim (recoverStuckRuns + lease logic).
  leaseExpiresAt    DateTime?
  // Coarse current-agent pointer for observability (e.g. "lead_discovery"
  // or "outreach_composer"). NULL until first agent step starts.
  currentAgentKey   String?
  // Free-form action descriptor for the current step (e.g. "tool:lead.search").
  currentAction     String?
  // JSON snapshot of the high-level invocation checkpoint:
  //   { "completedSteps": ["discovery","research"],
  //     "pendingStep": "qualification",
  //     "waitingCondition": null,
  //     "nextAction": { "tool": "lead.qualify", "input": {...} } }
  // Per-step granular checkpoints live in AutomationCheckpoint rows.
  currentCheckpoint String    @default("{}")
  // Retry state (bounded by maxRetries; default 3).
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  nextRetryAt       DateTime?
  // Waiting state — set when status = WAITING.
  //   WAITING_FOR_EMAIL | WAITING_FOR_APPROVAL | WAITING_FOR_FOLLOWUP
  //   | WAITING_FOR_SCHEDULE | WAITING_FOR_EXTERNAL_EVENT
  //   | WAITING_FOR_PROVIDER
  waitingCondition  String?
  // When the waiting condition should be re-checked (the "alarm clock").
  // NULL = indefinite wait (only external event can wake).
  nextWakeAt        DateTime?
  // Error classification for retry policy:
  //   retryable | permanent | human_required
  errorCategory     String?
  // Optional businessId denormalised from AutopilotWorkflow for fast
  // user-isolation filters without a join.
  businessId        String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([autopilotId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([executionId])
  // Part 1 — index for finding claimable invocations.
  @@index([status, leaseExpiresAt])
  // Part 1 — index for finding due wakeups.
  @@index([status, nextWakeAt])
  // Part 1 — user-scoped business isolation.
  @@index([userId, businessId])
  // Part 1 — event-trigger back-reference.
  @@index([triggerEventId])
}

model AutopilotLead {
  id          String   @id @default(cuid())
  autopilotId String
  runId       String
  leadId      String
  userId      String
  // DISCOVERED | EXEC_QUEUED | EXEC_FAILED
  status      String   @default("DISCOVERED")
  executionId String?
  error       String?
  createdAt   DateTime @default(now())

  // DB-level idempotency: one lead can only ever be processed once per autopilot.
  @@unique([autopilotId, leadId])
  @@index([runId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════
// Phase 20 — Custom Niches (additive).
//
// A user-owned niche beyond the predefined NICHE_OPTIONS vocabulary
// (e.g. "AI SaaS companies"). Canonical identity = (userId, nicheKey)
// where nicheKey is the normalized form (trimmed, whitespace-collapsed,
// lowercased) — "Dental Clinics", "dental clinics" and "DENTAL CLINICS"
// are the SAME logical niche for one user, but never across users.
// Saved custom niches are NEVER auto-deleted or auto-archived because
// they are not currently selected; status exists for future lifecycle
// phases only. Plain userId column (no Prisma relation) — same
// convention as AutopilotWorkflow/AutopilotRun/AutopilotLead.
// ═══════════════════════════════════════════════════════════════════
model CustomNiche {
  id        String   @id @default(cuid())
  userId    String
  // Display form exactly as the user saved it (their casing).
  name      String
  // Normalized identity: trim → collapse internal whitespace → lowercase.
  nicheKey  String
  // active | archived — only 'active' niches are listed/selectable.
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, nicheKey])
  @@index([userId, status])
}

// ═══════════════════════════════════════════════════════════════════
// Phase 25 — Execution Activity Tracking
//
// Unified event log that records discrete execution events (status
// transitions, retry events, cancellations, per-lead outcomes) for
// the Phase 24 execution engine.
//
// BEST-EFFORT logging: if a write fails, execution continues normally.
// Ownership-scoped: every record carries a userId for cross-user isolation.
// ═══════════════════════════════════════════════════════════════════

model ExecutionActivity {
  id          String   @id @default(cuid())
  runId       String? // AutopilotRun id (nullable for non-autopilot executions)
  executionId String? // WorkflowExecution id
  leadId      String? // Lead id (for per-lead events)
  eventType   String // RUN_QUEUED | RUN_STARTED | RUN_COMPLETED | RUN_FAILED | RUN_CANCELLED | RETRY_INITIATED | RESUME_INITIATED | EXECUTION_CREATED | EXECUTION_CHARGED | LEAD_COMPLETED | LEAD_FAILED | LEAD_DISCOVERED | SETTLE_FINALIZED
  fromStatus  String? // previous status (for transitions)
  toStatus    String? // new status (for transitions)
  detail      String? // JSON blob with additional context (error reason, retry attempt, etc.)
  userId      String // ownership scoping — User B can never see User A's activities
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([executionId])
  @@index([userId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// Phase 26 — Model Invocation (multi-model orchestration)
//
// One row per LOGICAL invocation slot:
//   (execution, lead, step, configured provider, configured model)
//
// · invocationKey is UNIQUE → DB-level duplicate-invocation protection
//   (same pattern as AutopilotRun.runKey).
// · status COMPLETED = durable output: retry/resume REUSES it instead of
//   re-invoking the provider (no duplicate generation / token spend).
// · status FAILED retried IN PLACE: attempt counter increments on the same
//   row — full retry history audit trail.
// · provider/model record the ACTUAL serving values (post-fallback);
//   the invocationKey encodes the CONFIGURED slot identity.
// ═══════════════════════════════════════════════════════════════════

model ModelInvocation {
  id            String    @id @default(cuid())
  invocationKey String    @unique
  executionId   String? // WorkflowExecution id
  runId         String? // AutopilotRun id (when orchestrated by autopilot)
  leadId        String? // Lead id (per-lead slots)
  stepName      String? // executing workflow step's name
  actionType    String? // ai_analysis | ai_outreach | score_lead | ...
  provider      String // ACTUAL serving provider (post-fallback)
  model         String // ACTUAL serving model reported by provider
  role          String? // logical slot role (e.g. 'analyst', 'critic')
  status        String    @default("RUNNING") // RUNNING | COMPLETED | FAILED | CANCELLED
  attempt       Int       @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  result        String? // JSON: { content, tokensUsed, retries }
  error         String?
  tokensUsed    Int?
  userId        String // ownership scoping — cross-user isolation
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([executionId])
  @@index([runId])
  @@index([leadId])
  @@index([userId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// Phase 26 v2 — Agentic Tool Layer schema (additive)
//
// Three new tables backing the agent tool layer (src/lib/ai/agent-tools/):
//   AgentActivity — audit log for every tool invocation
//   MessageDraft  — drafts created by message.draft tool
//   Task          — generic tasks created by task.create tool
//
// All tables are ownership-scoped (userId) and additive — no existing
// table is modified. Following the Phase 25/26 v1 pattern, userId is a
// plain String column (no Prisma relation), so no back-relation field
// is required on the User model.
// ═══════════════════════════════════════════════════════════════════

model AgentActivity {
  id           String   @id
  userId       String
  orgId        String?
  toolName     String
  invocationId String? // ModelInvocation id (when invoked by an AI agent)
  executionId  String? // WorkflowExecution id
  runId        String? // AutopilotRun id
  leadId       String? // Lead id (when scoped to a lead)
  input        String // JSON-serialized validated input
  status       String // success | error | unauthorized | not_found | validation_error
  durationMs   Int      @default(0)
  output       String? // JSON-serialized output (when status=success)
  error        String?
  fromCache    Int      @default(0) // 1 if served from idempotency cache
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([toolName])
  @@index([invocationId])
  @@index([executionId])
  @@index([runId])
  @@index([leadId])
  @@index([createdAt])
}

model MessageDraft {
  id        String   @id @default(cuid())
  userId    String
  orgId     String?
  leadId    String?
  subject   String
  body      String
  channel   String   @default("email") // email | whatsapp | telegram | linkedin
  status    String   @default("draft") // draft | approved | sent | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  orgId       String?
  leadId      String?
  title       String
  priority    String    @default("medium") // low | medium | high | urgent
  status      String    @default("open") // open | in_progress | completed | cancelled
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@index([dueAt])
}

// ═══════════════════════════════════════════════════════════════════
// Phase 26 v3 — User-level AI Provider Credentials (additive)
//
// Per-user encrypted storage for AI provider API keys.
// Resolution order at execution time:
//   1. UserAIProvider row (encrypted) — user's own key
//   2. process.env (platform-provided key)
//   3. Explicit error (no silent fallback to Z-AI)
//
// Encryption: AES-256-GCM. Master key from process.env.USER_AI_PROVIDER_ENCRYPTION_KEY
// (64-char hex string = 32 bytes). Encrypted payload stored as
// "v1:<iv_hex>:<auth_tag_hex>:<ciphertext_hex>" — versioned for forward
// compatibility with future key rotation.
//
// One row per (userId, provider) — UNIQUE constraint enforces no duplicates.
// Never expose decrypted credentials to the browser.
// ═══════════════════════════════════════════════════════════════════

model UserAIProvider {
  id                  String    @id @default(cuid())
  userId              String
  provider            String // openai | anthropic | gemini | deepseek | openrouter | z-ai
  encryptedCredential String // AES-256-GCM encrypted API key
  credentialHint      String // masked prefix for display (e.g. "sk-***...X4f2")
  modelPreferences    String    @default("{}") // JSON: { defaultModel: "gpt-4o", allowedModels: [...] }
  status              String    @default("active") // active | inactive | invalid
  lastValidatedAt     DateTime?
  lastValidationError String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// Phase 26 v3 — AI Agent System (Decisions 5+6+7+8+9+10+12+13)
//
// Persistent autonomous AI agents that reason + call approved tools +
// maintain state/memory + respect per-tool permissions. Distinct from
// Workflow (deterministic process) and Autopilot (scheduler).
//
// Per Decision 11: Autopilot remains the scheduler. Autopilot schedules
// workflows; workflows can invoke agents as steps. Agents are NOT a
// scheduler themselves — they run when triggered manually, by schedule
// (via Autopilot or AgentSchedule), or by event triggers.
//
// Per Decision 12: Agent uses a SINGLE provider+model as the reasoning
// brain. Multi-model orchestration belongs to workflow steps only.
//
// Per Decision 8: Per-tool permissions (not one global level). Persisted
// as JSON in toolPermissions.
// ═══════════════════════════════════════════════════════════════════

model Agent {
  id                   String    @id @default(cuid())
  userId               String
  orgId                String?
  name                 String
  description          String?
  // ── Workstream C §2 — first-class Agent abstraction ──
  // Long-form objective (what this agent exists to accomplish).
  objective            String?
  // Classification: 'system' (canonical, seeded) | 'custom' (user-created).
  // System agents are reusable across workflows and Autopilot.
  classification       String    @default("custom")
  // Stable system identifier for system agents ('DISCOVERY'|'RESEARCH'|
  // 'ENRICHMENT'|'QUALIFICATION'|'GAP_ANALYSIS'|'OPPORTUNITY'|
  // 'SOLUTION_MAPPING'|'LEAD_SCORING'|'OUTREACH'|'REPLY_ANALYSIS'|
  // 'FOLLOW_UP'|'CRM'|'REPORTING'). NULL for custom agents.
  // UNIQUE per (userId, systemKey) — at most one instance of each system
  // agent per user. NULL systemKey values are exempt (custom agents).
  systemKey            String?
  // AI Brain (Decision 12) — single provider+model for reasoning
  provider             String    @default("z-ai")
  model                String    @default("glm-4.6")
  // Model strategy (Workstream C §5) — JSON: { strategy: 'single' |
  // 'sequential' | 'parallel' | 'fallback', models?: [{provider,model,role}],
  // concurrency?: 1-4, fallback?: boolean }
  // Default 'single' — preserves Phase 26 v3 single-brain behavior.
  modelStrategy        String    @default("{\"strategy\":\"single\"}")
  // Memory scopes (Workstream C §7) — JSON array of scopes this agent
  // can read/write: ['user','business','lead','agent','execution','evidence'].
  // Default ['agent'] — only its own agent-scoped memory (Phase 26 v3 behavior).
  memoryScopes         String    @default("[\"agent\"]")
  // Current execution state (Workstream C §8) — granular state:
  // idle | running | reasoning | awaiting_tool | awaiting_approval |
  // paused | completed | failed | cancelled
  executionState       String    @default("idle")
  // Per-tool permissions (Decision 8) — JSON: { "email.send": "send_with_approval", "lead.update": "read-write", ... }
  // Value semantics: for email tools, matches ToolContext.emailPermission (read|draft|send_with_approval|autonomous).
  // For non-email tools: "read" (lookup only) | "read-write" (create/update) | "disabled" (tool not available).
  toolPermissions      String    @default("{}")
  // Permission categories (Workstream D §11) — JSON array of categories this
  // agent may perform: ['READ','ANALYZE','DRAFT','WRITE','SEND','DELETE',
  // 'MODIFY','TRIGGER_WORKFLOW','ESCALATE_HUMAN']. Default ['READ','ANALYZE','DRAFT']
  // (safe set). SEND/DELETE/MODIFY/TRIGGER_WORKFLOW require explicit grant.
  permissionCategories String    @default("[\"READ\",\"ANALYZE\",\"DRAFT\"]")
  // Schedule (Decision 10A) — JSON: { type: "cron"|"interval"|"none", cron?: "...", intervalSeconds?: N, nextRunAt?: "..." }
  schedule             String    @default("{\"type\":\"none\"}")
  // Triggers (Decision 10B) — JSON array: [{ event: "lead_reply"|"lead_created"|"score_change", condition: {...} }]
  triggers             String    @default("[]")
  // Approval policy (Decision 9) — "autonomous" (run without human approval) | "approval_required" (pause on actions needing approval)
  approvalPolicy       String    @default("approval_required")
  // Retry policy — JSON: { maxRetries: N, backoffMs: N }
  retryPolicy          String    @default("{\"maxRetries\":2,\"backoffMs\":1000}")
  // Memory configuration (Decision 13-H) — JSON: { windowSize: N (last N messages retained), maxTokens: N }
  memoryConfig         String    @default("{\"windowSize\":20,\"maxTokens\":4000}")
  // Status: draft | active | paused | disabled
  status               String    @default("draft")
  // Execution safety (Decision 6) — hard limits
  maxIterations        Int       @default(25) // max reasoning steps per run
  timeoutMs            Int       @default(300000) // 5 minutes default
  // Cumulative counters (honest, like AutopilotWorkflow)
  totalRuns            Int       @default(0)
  totalTokensUsed      Int       @default(0)
  lastRunAt            DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, systemKey])
  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([classification])
}

model AgentRun {
  id             String    @id @default(cuid())
  agentId        String
  userId         String
  orgId          String?
  // Trigger source: "manual" | "schedule" | "trigger:<event>" | "workflow:<executionId>"
  triggerSource  String
  status         String    @default("pending") // pending | running | completed | failed | cancelled | paused_awaiting_approval
  // Workstream C §8 — granular execution state for observability:
  // idle | running | reasoning | awaiting_tool | awaiting_approval |
  // paused | completed | failed | cancelled | timeout
  executionState String    @default("idle")
  // Checkpoint (Workstream C §8) — JSON: { iteration, memoryLength,
  // lastToolName, lastToolStatus } for resume after pause/timeout.
  // NULL when no checkpoint has been persisted.
  checkpoint     String?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  // Final result summary (JSON): { iterationsUsed, toolsCalled, tokensUsed, output }
  result         String?
  error          String?
  // Usage/cost metadata (Decision 19)
  tokensUsed     Int       @default(0)
  iterationsUsed Int       @default(0)
  toolsCalled    Int       @default(0)
  // Approval state (Decision 9) — "none" | "requested" | "approved" | "rejected"
  approvalState  String    @default("none")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([agentId])
  @@index([userId])
  @@index([status])
  @@index([executionState])
  @@index([triggerSource])
  @@index([createdAt])
}

model AgentMemory {
  id           String   @id @default(cuid())
  agentId      String
  // Role: "system" | "user" | "assistant" | "tool_result" | "reasoning"
  role         String
  content      String
  tokensUsed   Int      @default(0)
  // Optional: link to the run that produced this memory
  runId        String?
  // ── Workstream C §7 — provenance + scope + access policy ──
  // Memory scope: 'user' | 'business' | 'lead' | 'agent' | 'execution' | 'evidence'
  // Default 'agent' — preserves Phase 26 v3 behavior (per-agent memory).
  scope        String   @default("agent")
  // Provenance — what produced this memory. Examples:
  //   'agent:reasoning' | 'tool:lead.lookup' | 'provider:openai:gpt-4o' |
  //   'user:manual' | 'workflow:executeWorkflow' | 'autopilot:tick'
  source       String?
  // Freshness label — 'real-time' | 'recent' | 'stale' | 'unknown'
  freshness    String?
  // Confidence in the memory's accuracy (0.0 to 1.0)
  confidence   Float?
  // Version — bumped when memory is updated (optimistic concurrency)
  version      Int      @default(1)
  // Access policy — who can read this memory item
  // 'owner' (only the agent's owner) | 'org' (org members) | 'tenant' | 'global'
  // Default 'owner' — strictest. Prevents cross-user leakage.
  accessPolicy String   @default("owner")
  // Optional: link to the lead this memory is about (when scope='lead')
  leadId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agentId])
  @@index([runId])
  @@index([scope])
  @@index([leadId])
  @@index([createdAt])
}

model AgentApproval {
  id                  String    @id @default(cuid())
  userId              String // Workstream D — ownership scoping for approval decisions
  agentId             String
  runId               String
  // The tool invocation that needs approval (e.g. "email.send")
  toolName            String
  // The input that was about to be passed to the tool (JSON)
  input               String
  // Status: "requested" | "approved" | "rejected" | "expired"
  status              String    @default("requested")
  // ── Workstream C §9 — human-readable reason + context ──
  // Reason: why the agent is requesting approval (free-form text the
  // agent writes when it pauses — explains its plan + risk assessment).
  reason              String?
  // Context: JSON snapshot of the execution state at request time
  // { executionId, leadId, runState, iteration, lastToolName, ... }
  context             String?
  // ── Workstream D §8 — escalation payload ──
  riskLevel           String? // low | medium | high | critical
  expiresAt           DateTime?
  proposedAction      String? // human-readable summary of what the agent wants to do
  escalationChannel   String? // telegram | in_app | none
  escalationMessageId String? // Telegram message ID for followup
  requestedAt         DateTime  @default(now())
  decidedAt           DateTime?
  decidedBy           String? // userId of the human who decided
  // The deciding user's note (optional)
  decisionNote        String?
  // After decision, the tool invocation result (JSON) — for audit
  invocationResult    String?

  @@index([agentId])
  @@index([runId])
  @@index([userId, status])
  @@index([status])
  @@index([requestedAt])
}

// ═══════════════════════════════════════════════════════════════════
// Workstream B — Discovered Models (live model discovery + catalog cache)
//
// Per-user, per-provider cache of models discovered via authenticated
// list requests (OpenAI /v1/models, Gemini /v1beta/models, DeepSeek
// /v1/models, OpenRouter /v1/models) OR maintained provider-specific
// catalogs (Anthropic, Z-AI — these providers do not expose a public
// list endpoint; their entries are marked source='catalog').
//
// One row per (userId, provider, modelId) — UNIQUE constraint enforces
// no duplicates. Re-discovery upserts capabilities + lastVerifiedAt.
// ═══════════════════════════════════════════════════════════════════

model DiscoveredModel {
  id                       String   @id @default(cuid())
  userId                   String // ownership scoping — User B cannot see User A's discovered models
  provider                 String // openai | anthropic | gemini | deepseek | openrouter | z-ai | local
  modelId                  String // provider-specific model id (e.g. "gpt-4o")
  displayName              String? // human-readable name
  // 'live' = fetched via authenticated API list request; 'catalog' = maintained fallback list
  source                   String   @default("catalog")
  // Capability metadata (per user spec Workstream B §5)
  contextLength            Int? // max context tokens (null when unknown)
  supportsVision           Boolean  @default(false)
  supportsTools            Boolean  @default(false)
  supportsStructuredOutput Boolean  @default(false)
  supportsReasoning        Boolean  @default(false)
  // JSON array strings: ["text","image","audio"] for input/output modalities
  inputModalities          String? // JSON: ["text","image","audio"]
  outputModalities         String? // JSON: ["text","image","audio"]
  // Provider-reported status: available | deprecated | preview | unknown
  availability             String? // 'available' | 'deprecated' | 'preview' | 'unknown'
  lastVerifiedAt           DateTime @default(now())
  // Original JSON from provider for debugging (capped, never contains secrets)
  rawMetadata              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([userId, provider, modelId])
  @@index([userId, provider])
  @@index([provider])
  @@index([availability])
}

// ═══════════════════════════════════════════════════════════════════
// Workstream D — Agent Operation Registry (§13 idempotency)
// ═══════════════════════════════════════════════════════════════════

model AgentOperation {
  id            String    @id @default(cuid())
  userId        String
  operationType String // agent_run | workflow_start | tool_call | email_send | telegram_notify | approval_resume | continuation_step | external_callback
  fingerprint   String    @unique // sha256 of (userId+agentId+runId+opType+target+input+evidenceVersion)
  agentId       String?
  runId         String?
  status        String    @default("completed") // completed | failed
  resultType    String?
  resultId      String?
  resultRef     String? // JSON-serialized result for replay
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, operationType])
  @@index([userId, agentId])
  @@index([userId, runId])
}

// ═══════════════════════════════════════════════════════════════════
// Workstream D — Agent Event Queue (§6 event/trigger dispatcher)
// ═══════════════════════════════════════════════════════════════════

model AgentEvent {
  id             String    @id @default(cuid())
  userId         String
  eventType      String // scheduled | workflow_completion | new_lead | new_email | follow_up_due | approval_response | task_completion | retryable_failure | external_webhook
  payload        String // JSON
  source         String    @default("api")
  status         String    @default("pending") // pending | processing | processed | failed
  idempotencyKey String    @unique // dedupe key — same logical event never starts duplicate work
  correlationId  String?
  executionId    String?
  attempts       Int       @default(0)
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  error          String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, eventType])
  @@index([status, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// Workstream D — Connected Business Account (§1-3 connected accounts)
// ═══════════════════════════════════════════════════════════════════

model ConnectedAccount {
  id                   String    @id @default(cuid())
  userId               String
  kind                 String    @default("business_account") // ai_provider | business_account | human_channel
  provider             String // hostinger-mail | gmail-smtp | smtp-email | ...
  accountType          String    @default("email") // email | chat | ai_provider
  accountIdentifier    String // e.g. the email address
  status               String    @default("connected") // connected | disconnected | error | revoked
  capabilities         String? // JSON array: ["email.send","email.reply",...]
  credentialsEncrypted String? // AES-256-GCM encrypted credential JSON
  scopes               String? // JSON array: ["email.send","email.send:approval_required",...]
  meta                 String? // JSON: arbitrary provider-specific metadata
  lastValidatedAt      DateTime?
  lastError            String?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, provider, accountIdentifier])
  @@index([userId, provider])
  @@index([userId, status])
}

// ═══════════════════════════════════════════════════════════════════
// Part 1 — Durable Autonomous Autopilot Foundation
//
// Per-step execution checkpoint. One row per (invocation × step).
// Enables:
//   · restart-resume: load checkpoint, skip completed steps, resume
//   · crash recovery: lease expiry → next worker reads latest checkpoint
//   · observability: dashboard view of step progress
//
// Distinct from AgentRun.checkpoint (which is one agent's iteration
// state inside a single step) — AutomationCheckpoint tracks the
// multi-step pipeline shape (discovery → research → qualification →
// outreach → waiting).
// ═══════════════════════════════════════════════════════════════════

model AutomationCheckpoint {
  id               String    @id @default(cuid())
  invocationId     String // FK to AutopilotRun.id (logical FK; not enforced to avoid cascade churn)
  userId           String // denormalised for user isolation
  businessId       String? // denormalised from AutopilotWorkflow for fast scoping
  stepKey          String // canonical step id, e.g. "discovery" | "qualification" | "outreach"
  stepName         String // human-readable label, e.g. "Lead discovery"
  // PENDING | RUNNING | COMPLETE | FAILED | SKIPPED | WAITING
  status           String    @default("PENDING")
  // Ordering within the invocation. Lower = earlier. Stable across re-runs.
  sequence         Int       @default(0)
  // JSON result snapshot — idempotent replay can read this instead of
  // re-executing the underlying external action.
  //   { "discovered": 12, "leadIds": [...], "summary": "..." }
  result           String?
  // Free-form error text when status = FAILED.
  error            String?
  // Error classification reused from AutopilotRun.errorCategory.
  errorCategory    String?
  // If status = WAITING, the condition string (mirrors AutopilotRun.waitingCondition).
  waitingCondition String?
  // If status = WAITING, the alarm clock (mirrors AutopilotRun.nextWakeAt).
  nextWakeAt       DateTime?
  // Pointer to the next step's key (or null if this was the final step).
  nextAction       String?
  // Opaque token used by the worker to detect stale claim after resume:
  //   a worker sets claimNonce when marking RUNNING; on resume, the next
  //   worker replaces it. Stale workers detect mismatch and abort.
  claimNonce       String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // One step per invocation+key — re-running the same step reuses the row.
  @@unique([invocationId, stepKey])
  @@index([invocationId, sequence])
  @@index([invocationId, status])
  @@index([userId, businessId])
  @@index([status, nextWakeAt])
}

// ═══════════════════════════════════════════════════════════════════
// PHASE 33 — Admin Audit & Security Operations
//
// Additive fields on AuditLog for tamper-evident chain + security
// classification + before/after state + correlation ID.
// All fields are optional — existing rows (2231) get null.
// ═══════════════════════════════════════════════════════════════════

// Phase 33 audit chain fields (added to AuditLog via db push)
// These are NOT in the model above — they're added as a separate
// extension to avoid schema migration conflicts.

model SensitiveActionConfirmation {
  id            String    @id @default(cuid())
  actionType    String    // e.g. 'rbac_assign_role', 'config_change'
  targetId      String    // e.g. userId being modified
  adminId       String    // the admin requesting confirmation
  tokenHash     String    @unique // SHA-256 hash of the confirmation token (never store plaintext)
  status        String    @default("pending") // pending, approved, rejected, expired, used
  requestId     String?   // correlation ID
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime  // short-lived (5 minutes)
  usedAt        DateTime?

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([status])
  @@index([actionType])
  @@index([expiresAt])
}
