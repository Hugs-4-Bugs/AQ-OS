model Communication {
  id                   String  @id @default(cuid())
  leadId               String
  orgId                String?
  channel              String  @default("email")
  direction            String  @default("outbound")
  content              String
  messageGeneratedByAI Boolean @default(false)
  responseSummary      String?
  intent               String?
  buyingSignals        String?
