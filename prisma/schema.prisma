}

// ═══════════════════════════════════════════════════════════════════
// DISCOVERY JOB TABLES (Phase 7)
// ═══════════════════════════════════════════════════════════════════

model DiscoveryJob {
  id           String    @id @default(cuid())
  userId       String
  orgId        String?
  status       String    @default("pending") // pending, running, completed, failed
  source       String // google_maps, google_business, justdial, indiamart, yelp, yellow_pages, sulekha, linkedin, instagram, facebook, ai_search
  niche        String
  country      String
  city         String?
  totalFound   Int       @default(0)
  imported     Int       @default(0)
  duplicates   Int       @default(0)
  failed       Int       @default(0)
  // Candidates rejected AFTER provider results by the deterministic
  // hard-criteria validator (out of range / unverified / excluded type).
  filteredOut  Int       @default(0)
  errorMessage String?
  resultData   String? // JSON: { leads: [...] }
  startedAt    DateTime?
  completedAt  DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  total         Int      @default(0)
  progress      Int      @default(0)
  // Effective context/campaign override used for THIS discovery run (Discover
  // page context selector). JSON: { mode: 'none'|'campaign'|'business',
  // campaignId?, campaignNiche?, instructions? }. Persisted so historical jobs
  // remain explainable. Nullable + additive (legacy jobs read as no context).
  contextJson   String?
  // Phase 7 — terminal outcome classification, one of: success | partial |
  // zero_results | provider_failure | invalid_targeting. Nullable + additive:
  // legacy rows read as null and are derived from status/counts for display.
  outcome       String?
  // Phase 8/9 — parsed targeting plan for THIS run: { niches: string[],
  // countries: string[], city: string|null, combos: number }. Multi-niche and
  // multi-country runs stay explainable long after the input form is gone.
  // Nullable + additive (legacy jobs read as null).
  targetingJson String?

  @@index([userId])
  @@index([status])
  @@index([source])
  @@index([orgId])
}

