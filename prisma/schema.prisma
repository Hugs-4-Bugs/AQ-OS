// ═══════════════════════════════════════════════════════════════════
// AUDIT & SYSTEM TABLES
// ═══════════════════════════════════════════════════════════════════

model AuditLog {
  id         String  @id @default(cuid())
  userId     String
  action     String // login, logout, plan_change, gmail_connect, email_sent, etc.
  details    String? // JSON
  ipAddress  String?
  userAgent  String?
  resource   String? // lead, deal, user, etc.
  resourceId String? // ID of the affected resource

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  metadata  String?

  // Phase 33 — tamper-evident audit chain + security classification
  // All optional — existing rows get null (additive, no data loss)
  sequence         Int?     // sequential chain position
  previousHash     String?  // hash of the previous audit event
  eventHash        String?  // hash of this event's canonical payload
  severity         String?  // LOW, MEDIUM, HIGH, CRITICAL
  requestId        String?  // correlation ID
  outcome          String?  // success, denied, failed, confirmed
  beforeState      String?  // JSON snapshot of previous state (sanitized)
  afterState       String?  // JSON snapshot of resulting state (sanitized)
  securityEventType String? // authz_permission_denied, authz_role_change, etc.
  confirmed        Boolean? // whether sensitive action was confirmed

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([severity])
  @@index([requestId])
  @@index([securityEventType])
  @@index([sequence])
}

model SystemEvent {
  id         String    @id @default(cuid())
  type       String // error, warning, info, critical
  source     String // backend, celery, websocket, etc.
  message    String
  details    String? // JSON
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([source])
  @@index([resolved])
  @@index([createdAt])
}

