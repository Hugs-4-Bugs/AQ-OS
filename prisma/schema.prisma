// ═══════════════════════════════════════════════════════════════════
// PROSPECTING PIPELINE (5-Step AI Prospect Intelligence)
// STEP 1 Deep Research → STEP 2 Gap Detection → STEP 3 Offer Match
// → STEP 4 Personalized Pitch → STEP 5 Smart Email
// ═══════════════════════════════════════════════════════════════════

model ProspectPipeline {
  id          String   @id @default(cuid())
  leadId      String
  userId      String
  status      String   @default("idle") // idle | running | completed | failed
  currentStep Int      @default(0) // 0 = not started; 1..5 = step currently running
  totalSteps  Int      @default(5)
  stepStatus  String   @default("{}") // JSON: { "1": "pending|running|completed|failed|skipped" }
  progress    Int      @default(0) // 0-100
  step1ResearchJson String? // STEP 1: company deep research result (JSON)
  step2GapsJson     String? // STEP 2: detected gaps (JSON)
  step3MatchJson    String? // STEP 3: offer-vs-gap match result (JSON)
  step4PitchJson    String? // STEP 4: personalized pitch (JSON)
  step5EmailJson    String? // STEP 5: smart email draft (JSON)
  overallScore      Float? // 0-100 offer-fit score
  temperature       String? // hot | warm | cold
  outreachMessageId String? // OutreachMessage draft created by STEP 5
  error       String?
  startedAt   DateTime?
  completedAt DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}
