// ═══════════════════════════════════════════════════════════════════
// OUTREACH TABLES
// [MIGRATE-NOTE] OutreachSequence.steps is a [JSON-FIELD].
//   OutreachMessage.trackingPixelId is @unique — verify uniqueness.
// ═══════════════════════════════════════════════════════════════════

model OutreachMessage {
  id                 String    @id @default(cuid())
  leadId             String
  userId             String?
  channel            String // email, whatsapp, linkedin, instagram
  direction          String    @default("outbound")
  subject            String?
  content            String
  // Status states: draft, approval_required, queued, sending, provider_accepted,
  // sent, delivered, opened, replied, bounced, failed, rejected, rate_limited,
  // retrying, cancelled. Never mark "sent" unless provider confirms acceptance.
  status             String    @default("draft")
  sentAt             DateTime?
  providerAcceptedAt DateTime? // When provider API accepted (distinct from actual send)
  openedAt           DateTime?
  repliedAt          DateTime?
  bouncedAt          DateTime?
  generatedByAI      Boolean   @default(false)
  sequenceStepId     String? // null = manual/outreach, set = from sequence
  trackingPixelId    String?   @unique
  metadata           String? // JSON for additional data
  providerMessageId  String? // External ID returned by provider (idempotency + dedup)
  errorCategory      String? // rate_limit, auth_failure, network_error, content_rejected, recipient_invalid, provider_error, provider_blocked, unknown
  errorMessage       String?
  retryCount         Int       @default(0)
  maxRetries         Int       @default(3)
  nextRetryAt        DateTime?

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  sequenceStep SequenceStep? @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([sentAt])
  @@index([trackingPixelId])
  @@index([userId, status])
  @@index([sequenceStepId])
}

model OutreachSequence {
  id          String  @id @default(cuid())
  userId      String
  orgId       String?
  name        String
  description String?
  status      String  @default("draft") // draft, active, paused, completed
  steps       String  @default("[]") // JSON array of step definitions
  channel     String  @default("email")

  enrollments   SequenceEnrollment[]
  sequenceSteps SequenceStep[]

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orgId])
}

model SequenceStep {
  id         String  @id @default(cuid())
  sequenceId String
  order      Int
  channel    String // email, whatsapp, linkedin, instagram
  subject    String?
  template   String
