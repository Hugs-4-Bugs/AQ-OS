  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([dealId])
  @@index([status])
  @@index([startDateTime])
  @@index([calendarEventId])
  @@index([platform])
  @@index([createdBy])
  @@index([userId, status])
  @@index([orgId])
}

