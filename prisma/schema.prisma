// ═══════════════════════════════════════════════════════════════════
// WORKFLOW TABLES
// [MIGRATE-NOTE] WorkflowDefinition.nodes/edges are [JSON-FIELD]s.
//   WorkflowExecution has many JSON fields (triggerData, logs, error).
// ═══════════════════════════════════════════════════════════════════

model WorkflowDefinition {
  id                     String           @id @default(cuid())
  userId                 String
  orgId                  String?
  name                   String
  description            String?
  status                 String           @default("draft") // draft, active, paused, archived
  triggerType            String // lead_stage_change, lead_reply, score_change, manual, scheduled, payment_received
  triggerConfig          String? // JSON: { stage: "replied", scoreThreshold: 80, schedule: "daily", ... }
  nodes                  String           @default("[]") // JSON array of workflow node definitions
  edges                  String           @default("[]") // JSON array of edge connections
  version                Int              @default(1)
  isTemplate             Boolean          @default(false)
  templateCategory       String?
  // Distinguishes "system-paused due to subscription expiry" (true)
  // from "user-manually-paused" (false). Only the former auto-resumes on repurchase.
  disabledBySubscription Boolean          @default(false)
  // Human-approval gate: when true, send actions create drafts/notifications
  // instead of sending — a human must approve the outreach (additive, default
  // preserves existing behavior).
  requiresApproval       Boolean          @default(false)
  // Optional Business Profile association (one workflow belongs to exactly one
  // profile/niche; nullable so existing workflows remain valid).
  profileId              String?
  businessProfile        BusinessProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  executions    WorkflowExecution[]
  workflowSteps WorkflowStep[]

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  runCount       Int       @default(0)
  successCount   Int       @default(0)
  failureCount   Int       @default(0)
  avgRuntimeMs   Float?
  lastRunAt      DateTime?
  webhookPath    String?
  maxRetries     Int?
  maxConcurrency Int?

  @@index([userId])
  @@index([status])
  @@index([triggerType])
  @@index([orgId])
}

model WorkflowStep {
  id         String  @id @default(cuid())
  workflowId String
  type       String // action, condition, delay, ai_action
  name       String
  config     String // JSON: step-specific configuration
  order      Int
  nextStepId String? // For linear workflows

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([order])
}

model WorkflowExecution {
  id               String    @id @default(cuid())
  workflowId       String
  status           String    @default("running") // running, completed, failed, cancelled, paused, discovering, partial, exhausted
  triggerData      String? // JSON: data that triggered this execution
  logs             String? // JSON array of execution logs
  currentStep      Int       @default(0)
  totalSteps       Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  error            String?
  retryCount       Int       @default(0)
  maxRetries       Int       @default(3)
  timeoutMs        Int       @default(300000)
  idempotencyKey   String?
  pausedAt         DateTime?
  resumedAt        DateTime?
  triggerEvent     String? // JSON: the event that triggered this execution
  deadLettered     Boolean   @default(false)
  deadLetterReason String?

  workflow  WorkflowDefinition      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepLogs  WorkflowLog[]
  leadItems WorkflowExecutionLead[]

  createdAt    DateTime  @default(now())
  durationMs   Int?
  isDeadLetter Boolean   @default(false)
  lastRetryAt  DateTime?
  userId       String?

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
  @@index([idempotencyKey])
  @@index([deadLettered])
  // DB-enforced idempotency backstop for workflow execution. When a caller
  // supplies an idempotencyKey (target.runId, batch runBatchId, trigger
  // stableEventId, autopilot runId), the (workflowId, idempotencyKey) pair
  // must be unique so a concurrent duplicate trigger cannot create a second
  // execution row for the same logical run. SQLite treats NULLs as distinct
  // under UNIQUE, so legacy/autonomous executions without a key keep NULL
  // without colliding. The application-level findFirst pre-check remains as
  // the fast path; this constraint is the race loser's safety net (P2002 →
  // re-read existing execution).
  @@unique([workflowId, idempotencyKey])
}

// Multi-lead execution model: ONE WorkflowExecution row represents the whole
// workflow run; each targeted lead is tracked as a child item row. Additive
// table (Oct 2026) — no existing table/column was altered.
model WorkflowExecutionLead {
  id          String    @id @default(cuid())
  executionId String
  leadId      String?
  leadName    String?
  niche       String?
  // pending → running → completed / failed / skipped
  status      String    @default("pending")
  attempts    Int       @default(0)
  error       String?
  // JSON summary of this lead's per-step outcomes (name/status/duration)
  stepSummary String?
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([leadId])
  @@index([status])
}

model WorkflowLog {
  id          String  @id @default(cuid())
  executionId String
  stepName    String
  stepType    String
  status      String // success, failed, skipped
  input       String? // JSON
  output      String? // JSON
  error       String?
  durationMs  Int?
  userId      String?

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  retryAttempt Int?

  @@index([executionId])
  @@index([status])
}

model WorkflowTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String
  category      String // nurture, follow_up, alert, onboarding, enrichment, outreach
  triggerType   String
  triggerConfig String?
  nodes         String   @default("[]") // JSON
  edges         String   @default("[]") // JSON
  isPremium     Boolean  @default(false)
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
}

